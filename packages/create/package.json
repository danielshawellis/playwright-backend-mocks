{
  "name": "@playwright-backend-mocks/create",
  "version": "0.1.8",
  "description": "Scaffold a Playwright Backend Mocks getting-started example",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-playwright-backend-mocks": "./dist/cli.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "build": "node ./scripts/sync-template.mjs && tsup",
