    "sync-template": "node ./scripts/sync-template.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielshawellis/playwright-backend-mocks.git",
    "directory": "packages/create"
  },
  "homepage": "https://danielshawellis.github.io/playwright-backend-mocks/guide/getting-started",
  "bugs": {
    "url": "https://github.com/danielshawellis/playwright-backend-mocks/issues"
  }
