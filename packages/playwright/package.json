{
  "name": "@playwright-backend-mocks/playwright",
  "version": "0.1.0",
  "description": "Playwright fixtures for mocking Node.js backend HTTP",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@playwright-backend-mocks/protocol": "workspace:*",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@playwright/test": "1.62.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
