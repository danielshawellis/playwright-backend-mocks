{
  "name": "@playwright-backend-mocks/node",
  "version": "0.1.0",
  "description": "Node.js interception agent for Playwright Backend Mocks",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mswjs/interceptors": "^0.42.3",
    "@playwright-backend-mocks/protocol": "workspace:*",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielshawellis/playwright-backend-mocks.git",
    "directory": "packages/node"
  },
  "homepage": "https://danielshawellis.github.io/playwright-backend-mocks/",
  "bugs": {
    "url": "https://github.com/danielshawellis/playwright-backend-mocks/issues"
  }
}
