{
  "name": "@playwright-backend-mocks/dashboard",
  "version": "0.1.6",
  "description": "Standalone read-only dashboard for Playwright Backend Mocks",
  "license": "MIT",
  "type": "module",
  "bin": {
    "playwright-backend-mocks-dashboard": "./dist/cli.cjs"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsup",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cli.json --noEmit",
    "start": "node ./dist/cli.cjs"
  },
  "devDependencies": {
    "@playwright-backend-mocks/protocol": "workspace:*",
    "@vitejs/plugin-vue": "^5.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue": "^3.5.17",
    "vue-tsc": "^2.2.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielshawellis/playwright-backend-mocks.git",
    "directory": "packages/dashboard"
  },
  "homepage": "https://danielshawellis.github.io/playwright-backend-mocks/",
  "bugs": {
    "url": "https://github.com/danielshawellis/playwright-backend-mocks/issues"
  }
}
